# ---- Local development ----
# Local dev uses a plain SQLite file. Turso vars are only needed to talk to the cloud DB.
DATABASE_URL="file:./dev.db"

# ---- Turso (production DB) ----
# Get these from the Turso dashboard / `turso db show <name>` + `turso db tokens create <name>`.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=""

# ---- Admin panel ----
# Password for /admin/login. Choose a strong value; set the SAME value in Vercel env vars.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie (any long random string).
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"

# ---- LINE Messaging API (internal notifications) ----
# From LINE Developers Console -> your Messaging API channel.
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# Where new-inquiry notifications are pushed: a userId (Uxxxx) or groupId (Cxxxx).
# Leave blank to disable push (inquiries are still saved).
LINE_NOTIFY_TARGET=""

# ---- Site ----
# Public base URL, used for canonical/sitemap/OG. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://localwanderttc-7985.vercel.app"
